# Copy to .env, then: chmod 600 .env
# The app starts without these values; Beszel telemetry falls back to offline
# until they are valid.
BESZEL_URL=https://beszel.example.com
BESZEL_EMAIL=portfolio-readonly@example.com
BESZEL_PASSWORD=your_password_here
BESZEL_SYSTEM=example-system
BESZEL_DISPLAY_NAME=Primary system
BESZEL_REVALIDATE=30

# Second system in the same Beszel hub. Only the system name differs; the URL
# and the read-only credentials above are reused. BESZEL_VPS_SYSTEM defaults to
# "VPS" when unset, so this block is optional.
BESZEL_VPS_SYSTEM=VPS
# BESZEL_VPS_DISPLAY_NAME=Secondary system
